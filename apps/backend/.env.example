# Local development. Docker Compose brings this database up; see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://tilik:tilik@localhost:5432/tilik_klaim

# Origin peramban yang boleh memanggil API ini, dipisah koma. Wajib diisi ulang saat
# di-deploy: isi dengan URL web di Vercel, mis.
#   CORS_ALLOW_ORIGINS=https://tilik-klaim.vercel.app
# Bila API dipanggil dari lokal sekaligus dari Vercel, cantumkan keduanya.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Opsional. Vercel memberi URL berbeda untuk tiap preview deployment; pola ini yang
# membuatnya lolos tanpa didaftarkan satu per satu. Kosongkan bila tidak dipakai.
# Contoh: ^https://tilik-klaim-[a-z0-9-]+\.vercel\.app$
CORS_ALLOW_ORIGIN_REGEX=

# Engine identity — recorded on every case and audit event.
ENGINE_VERSION=0.1.0
RULESET_VERSION=0.1.0
DATASET_VERSION=unset

# Ingestion limits.
MAX_BUNDLE_BYTES=8388608
MAX_JSON_DEPTH=32

# Ringkasan bukti (ADR-0005) — LLM terbatas, hanya-baca, di luar jalur skor risiko.
# MATI secara bawaan. Tanpa kunci atau model, endpoint menjawab dengan templat deterministik.
# Gateway apa pun yang kompatibel dengan OpenAI chat-completions bisa dipakai (OpenRouter, LiteLLM).
BRIEFING_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
BRIEFING_TIMEOUT_SECONDS=20
BRIEFING_MAX_TOOL_CALLS=8
