# Custom
.claude
docs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/

# Playwright — traces and screenshots of a run, regenerated by `npm run test:e2e`.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Environment
.env
.env.local

# Generated data and evaluation artifacts — reproducible from seed, never committed.
data/generated/
evaluation/artifacts/*/
!evaluation/artifacts/.gitkeep
# ...except the one frozen run the proposal cites. The deployed image cannot regenerate it, so it
# is the only evaluation evidence the Audit & Evaluasi page can ever show there.
!evaluation/artifacts/run-20260901T110000Z/

# OS
.DS_Store
