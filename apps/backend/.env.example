# Local development. Docker Compose brings this database up; see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://tilik:tilik@localhost:5432/tilik_klaim

# Origin peramban yang boleh memanggil API ini, dipisah koma. Wajib diisi ulang saat
# di-deploy: isi dengan URL web di Vercel, mis.
#   CORS_ALLOW_ORIGINS=https://tilik-klaim.vercel.app
# Bila API dipanggil dari lokal sekaligus dari Vercel, cantumkan keduanya.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Opsional. Vercel memberi URL berbeda untuk tiap preview deployment; pola ini yang
# membuatnya lolos tanpa didaftarkan satu per satu. Kosongkan bila tidak dipakai.
# Contoh: ^https://tilik-klaim-[a-z0-9-]+\.vercel\.app$
CORS_ALLOW_ORIGIN_REGEX=

# Engine identity — recorded on every case and audit event.
ENGINE_VERSION=0.1.0
RULESET_VERSION=0.1.0
DATASET_VERSION=unset

# Ingestion limits.
MAX_BUNDLE_BYTES=8388608
MAX_JSON_DEPTH=32

# Ringkasan bukti (ADR-0005) — LLM terbatas, hanya-baca, di luar jalur skor risiko.
#
# MATI secara bawaan, dan selama mati tidak ada satu pun nilai di bawah yang wajib diisi:
# endpoint menjawab dengan templat deterministik, dan itu bukan galat. Demo luring memakai
# jalur ini (docs/canonical/08_demo_runbook.md: "Never depend on a remote LLM").
#
# Begitu BRIEFING_ENABLED=true, ketiganya WAJIB terisi dan layanan MENOLAK START bila tidak —
# lebih baik gagal saat deploy daripada saat demo.
BRIEFING_ENABLED=false

# Nama model di gerbang. Qwen3.5-9B serba guna & cepat; gpt-oss-20b model reasoning yang
# jauh lebih lambat. Roster lengkap:
#   curl -H "Authorization: Bearer $VLLM_API_KEY" "$VLLM_BASE_URL/models"
LLM_MODEL_VLLM=Qwen3.5-9B

# SENGAJA KOSONG — alamat gerbang adalah fakta deployment, bukan konstanta program, dan
# tidak pernah di-commit. Harus berakhir dengan /v1. Alamatnya ada di docs/VLLM-SETUP.md
# (tidak ikut ter-commit); isi nilainya hanya di apps/backend/.env.
VLLM_BASE_URL=

# RAHASIA — SENGAJA KOSONG. Diisi hanya di .env atau secret manager, tidak pernah di sini.
# Placeholder berbentuk kunci lolos pemeriksaan mata dan berakhir sebagai 401 di produksi,
# jadi nilai seperti "dummy" ditolak oleh config.py.
VLLM_API_KEY=

# Timeout WAJIB longgar: port tertutup di host gerbang MENGGANTUNG, bukan gagal cepat.
BRIEFING_TIMEOUT_SECONDS=90
BRIEFING_MAX_TOOL_CALLS=8

# Qwen3.5 adalah model reasoning hibrida. Terukur di gerbang ini: dengan mode berpikir MENYALA,
# ~3.500 token penalaran tersembunyi ikut dihitung terhadap batas keluaran — jawaban 2.300
# karakter yang sudah lengkap tetap terpotong setelah 43 detik. MATI: 6,5 detik, 456 token.
# Meringkas bukti yang sudah dikumpulkan di bawah skema bukan tugas penalaran.
BRIEFING_ENABLE_THINKING=false
BRIEFING_TEMPERATURE=0.1
# NOL, bukan dua: templat deterministik ITULAH percobaan ulangnya. Dengan timeout 90 detik,
# dua retry membuat satu panggilan mencapai 4,5 menit — dan panel ini diminta di depan peninjau.
BRIEFING_MAX_RETRY=0
# Anggaran waktu untuk keseluruhan proses, termasuk pembacaan alat.
BRIEFING_DEADLINE_SECONDS=120
